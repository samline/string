{
  "name": "@samline/string",
  "version": "1.0.0",
  "description": "Case conversion, slugify, accents, truncate and initials built on one Unicode-aware word splitter, for vanilla JavaScript, TypeScript and plain HTML.",
  "keywords": [
    "string",
    "case",
    "camelcase",
    "kebab-case",
    "snake-case",
    "slugify",
    "slug",
    "title-case",
    "accents",
    "truncate"
  ],
  "author": "Samuel Olvera (samline)",
  "license": "MIT",
  "homepage": "https://samline.github.io/string/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/string.git"
  },
  "bugs": {
    "url": "https://github.com/samline/string/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/browser/string.global.js"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/string.global.js",
  "jsdelivr": "./dist/browser/string.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./browser": "./dist/browser/string.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run test:coverage && bun run build && bun run size && bun run test:e2e",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage",
    "release": "bun run check && pnpm publish"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "size": {
    "./dist/index.js": 1500,
    "./dist/browser/string.global.js": 1500
  }
}
