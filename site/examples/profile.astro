---
import './_shared.css'
---

<div class="preview string-example" data-preview="profile">
  <div class="profile">
    <span class="avatar" data-string="initials" data-string-color>Ana María López</span>
    <span class="file" data-string-fit>resume-ana-maria-lopez-2026-final-version.pdf</span>
  </div>
  <label for="preview-bio">Bio</label>
  <textarea id="preview-bio" maxlength="80" rows="3">Designs accessible interfaces 🎨</textarea>
  <output data-string-count="#preview-bio" data-string-count-format="{remaining} characters left"
  ></output>
  <label for="preview-handle">Display name</label>
  <input id="preview-handle" value="Ana María López" />
  <button type="button" data-string-copy="#preview-handle" data-string-copy-as="slug"
    ><span>Copy as handle</span></button
  >
</div>

<script>
  import { autoCopy, autoCount, autoFit, autoString } from '@samline/string/vanilla'
  import { preview } from '../../shared/lib/preview'

  preview('profile', stage => {
    const scope = stage.querySelector<HTMLElement>('[data-preview="profile"]')!
    return [
      autoString({ scope }),
      autoFit({ scope }),
      autoCount({ scope }),
      autoCopy({ scope }),
    ]
  })
</script>
