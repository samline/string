---
import './_shared.css'
---

<div class="preview string-example" data-preview="files">
  <form class="add-file">
    <label for="preview-file-name">Add a file</label>
    <div class="inline">
      <input id="preview-file-name" type="text" value="report 3.pdf" />
      <button type="submit">Add</button>
    </div>
  </form>
  <div class="columns">
    <section>
      <h3><code>sort()</code></h3>
      <ol data-plain></ol>
    </section>
    <section>
      <h3><code>sort(compareNatural)</code></h3>
      <ol data-natural></ol>
    </section>
  </div>
</div>

<script>
  import { compareNatural } from '@samline/string'
  import { preview } from '../../shared/lib/preview'

  preview('files', stage => {
    const root = stage.querySelector<HTMLElement>('[data-preview="files"]')!
    const files = [
      'report 10.pdf',
      'Report 2.pdf',
      'éclair.jpg',
      'report 1.pdf',
      'photo 12.jpg',
      'Photo 9.jpg',
    ]
    const input = root.querySelector('input')!

    const show = (list: HTMLElement, names: string[]) =>
      list.replaceChildren(
        ...names.map(name => Object.assign(document.createElement('li'), { textContent: name }))
      )

    const update = () => {
      show(root.querySelector('[data-plain]')!, [...files].sort())
      show(root.querySelector('[data-natural]')!, [...files].sort(compareNatural))
    }

    root.querySelector('form')!.addEventListener('submit', event => {
      event.preventDefault()
      if (input.value.trim()) files.push(input.value.trim())
      input.value = ''
      update()
    })
    update()
  })
</script>
