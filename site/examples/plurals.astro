---
import './_shared.css'

const rows = [
  ['en', 'English', 'en'],
  ['ordinal', 'English ordinal', 'en'],
  ['es', 'Spanish', 'es'],
  ['pl', 'Polish', 'pl'],
  ['ru', 'Russian', 'ru'],
] as const
---

<div class="preview string-example" data-preview="plurals">
  <label for="preview-amount">Number</label>
  <input id="preview-amount" class="number" type="number" min="0" max="200" value="2" />
  <table>
    <thead>
      <tr><th scope="col">Language</th><th scope="col">Result</th></tr>
    </thead>
    <tbody>
      {
        rows.map(([id, label, lang]) => (
          <tr>
            <th scope="row">{label}</th>
            <td lang={lang} data-plural={id} />
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<script>
  import { pluralize, type PluralForms, type PluralizeOptions } from '@samline/string'
  import { preview } from '../../shared/lib/preview'

  preview('plurals', stage => {
    const forms: Record<string, [PluralForms, PluralizeOptions]> = {
      en: [{ one: '# file', other: '# files' }, { locale: 'en' }],
      ordinal: [
        { one: '#st place', two: '#nd place', few: '#rd place', other: '#th place' },
        { locale: 'en', ordinal: true },
      ],
      es: [{ zero: 'Ningún archivo', one: '# archivo', other: '# archivos' }, { locale: 'es' }],
      pl: [{ one: '# plik', few: '# pliki', many: '# plików', other: '# pliku' }, { locale: 'pl' }],
      ru: [{ one: '# файл', few: '# файла', many: '# файлов', other: '# файла' }, { locale: 'ru' }],
    }
    const root = stage.querySelector<HTMLElement>('[data-preview="plurals"]')!
    const amount = root.querySelector('input')!

    const update = () => {
      const count = Math.max(0, Math.floor(Number(amount.value) || 0))
      for (const cell of root.querySelectorAll<HTMLElement>('[data-plural]'))
        cell.textContent = pluralize(count, ...forms[cell.dataset.plural!]!)
    }
    amount.addEventListener('input', update)
    update()
  })
</script>
