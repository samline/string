---
import './_shared.css'
---

<div class="preview string-example" data-preview="article">
  <article>
    <h3>Café de olla</h3>
    <p>El <b>café de olla</b> se prepara con canela y piloncillo en una olla de barro.</p>
    <p>
      Hierve el agua, añade el piloncillo y la canela, y deja reposar el café cinco minutos antes
      de colarlo.
    </p>
  </article>
  <p data-meta></p>
  <p data-excerpt></p>
  <p data-greeting></p>
</div>

<script>
  import { pluralize, readingTime, stripTags, template, truncate } from '@samline/string'

  const root = document.querySelector<HTMLElement>('[data-preview="article"]')!
  const post = root.querySelector('article')!
  const comments = 3
  const { minutes, words } = readingTime(post.textContent ?? '', { locale: 'es' })

  root.querySelector('[data-meta]')!.textContent = [
    pluralize(minutes, { one: '# minuto de lectura', other: '# minutos de lectura' }, { locale: 'es' }),
    pluralize(words, { one: '# palabra', other: '# palabras' }, { locale: 'es' }),
    pluralize(
      comments,
      { zero: 'Sin comentarios', one: '# comentario', other: '# comentarios' },
      { locale: 'es' }
    ),
  ].join(' · ')

  root.querySelector('[data-excerpt]')!.textContent = truncate(stripTags(post.innerHTML), 90)

  root.querySelector('[data-greeting]')!.textContent = template(
    'Hola {user.name}, tienes {count} borradores.',
    { user: { name: 'Ana' }, count: 2 }
  )
</script>
