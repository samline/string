---
import './_shared.css'
---

<div class="preview string-example" data-preview="article">
  <article>
    <h3>Cold brew at home</h3>
    <div class="body">
      <p><b>Cold brew</b> steeps coarse coffee in cold water for hours instead of minutes.</p>
      <p>
        Grind the beans, stir them into the water, and let the jar rest overnight before you strain
        it.
      </p>
    </div>
  </article>
  <p data-meta></p>
  <p data-excerpt></p>
  <p data-greeting></p>
</div>

<script>
  import { pluralize, readingTime, stripTags, template, truncate } from '@samline/string'

  const root = document.querySelector<HTMLElement>('[data-preview="article"]')!
  const post = root.querySelector('article')!
  const comments = 3
  const { minutes, words } = readingTime(post.textContent ?? '', { locale: 'en' })

  root.querySelector('[data-meta]')!.textContent = [
    pluralize(minutes, { one: '# minute read', other: '# minutes read' }, { locale: 'en' }),
    pluralize(words, { one: '# word', other: '# words' }, { locale: 'en' }),
    pluralize(
      comments,
      { zero: 'No comments', one: '# comment', other: '# comments' },
      { locale: 'en' }
    ),
  ].join(' · ')

  const body = post.querySelector('.body')!
  root.querySelector('[data-excerpt]')!.textContent = truncate(stripTags(body.innerHTML), 90)

  root.querySelector('[data-greeting]')!.textContent = template(
    'Hi {user.name}, you have {count} drafts.',
    { user: { name: 'Ana' }, count: 2 }
  )
</script>
