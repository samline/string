---
import './_shared.css'
---

<div class="preview string-example" data-preview="slug">
  <label for="preview-title">Title</label>
  <input id="preview-title" type="text" value="Café & Té: Guía 2026" />
  <label for="preview-slug">Slug</label>
  <input
    id="preview-slug"
    type="text"
    data-string="slug"
    data-string-source="#preview-title"
    data-string-replacements='{"&": "y"}'
  />
  <p>example.com/blog/<code data-string="slug" data-string-source="#preview-slug"></code></p>
  <p data-status></p>
</div>

<script>
  import { string } from '@samline/string/vanilla'
  import { preview } from '../../shared/lib/preview'

  preview('slug', stage => {
    const root = stage.querySelector<HTMLElement>('[data-preview="slug"]')!
    const controller = string(root.querySelectorAll('[data-string]'))

    const slug = root.querySelector<HTMLInputElement>('#preview-slug')!
    const status = root.querySelector<HTMLElement>('[data-status]')!
    const show = () =>
      (status.textContent =
        slug.dataset.stringState === 'edited'
          ? 'Edited by hand. Empty the field to follow the title again.'
          : 'Follows the title.')
    slug.addEventListener('string:change', show)
    slug.addEventListener('input', show)
    show()
    return controller
  })
</script>
