---
import './_shared.css'
---

<div class="preview string-example" data-preview="suggest">
  <label for="preview-country">Country</label>
  <input
    id="preview-country"
    type="search"
    autocomplete="off"
    aria-describedby="preview-country-status"
  />
  <p id="preview-country-status" aria-live="polite"></p>
  <ul class="search-list"></ul>
</div>

<script>
  import { closest, contains, highlight } from '@samline/string'

  const root = document.querySelector<HTMLElement>('[data-preview="suggest"]')!
  const countries = [
    'México',
    'Perú',
    'Panamá',
    'España',
    'Japón',
    'Canadá',
    'Brasil',
    'Bélgica',
    'Türkiye',
    "Côte d'Ivoire",
  ]
  const input = root.querySelector('input')!
  const list = root.querySelector('ul')!
  const status = root.querySelector('p')!

  const marked = (name: string) =>
    highlight(name, input.value).map(({ text, match }) =>
      match ? Object.assign(document.createElement('mark'), { textContent: text }) : text
    )

  const update = () => {
    const query = input.value.trim()
    const found = query ? countries.filter(name => contains(name, query)) : []
    list.replaceChildren(
      ...found.map(name => {
        const item = document.createElement('li')
        item.append(...marked(name))
        return item
      })
    )
    const guess = query && !found.length ? closest(query, countries) : undefined
    status.textContent = !query
      ? 'Type a country, with or without accents.'
      : guess
        ? `No match. Did you mean ${guess}?`
        : found.length
          ? `${found.length} found`
          : 'No match.'
  }
  input.addEventListener('input', update)
  update()
</script>
